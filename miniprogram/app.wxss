page {
  min-height: 100%;
  background: #efe6d4;
  color: #201f1a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  box-sizing: border-box;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
