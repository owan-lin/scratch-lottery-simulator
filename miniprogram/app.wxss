page {
  min-height: 100%;
  width: 100%;
  overflow-x: hidden;
  background: #efe6d4;
  color: #201f1a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
button,
input,
scroll-view,
picker,
canvas,
image {
  box-sizing: border-box;
}

button {
  min-width: 0;
  max-width: 100%;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  width: 100%;
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

.safe-bottom {
  height: env(safe-area-inset-bottom);
}
